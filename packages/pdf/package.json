{
  "name": "@node-media-library/pdf",
  "version": "0.0.0",
  "type": "module",
  "description": "pdftoppm-backed ImageGenerator for rasterizing PDF originals in @node-media-library/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujtabarumi/node-media-library.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/mujtabarumi/node-media-library/tree/main/packages/pdf#readme",
  "bugs": {
    "url": "https://github.com/mujtabarumi/node-media-library/issues"
  },
  "keywords": [
    "media-library",
    "uploads",
    "conversions",
    "pdf"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/ensure-pnpm-pack.mjs"
  },
  "dependencies": {
    "@node-media-library/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
