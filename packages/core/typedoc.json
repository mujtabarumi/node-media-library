{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  // Deliberately NOT inside website/src/content/docs. Starlight's collection
  // schema requires `title` frontmatter and this plugin emits none, so writing
  // there fails `astro build` outright. Publishing these pages needs
  // starlight-typedoc (which adds the frontmatter) — see the PR discussion.
  "out": "./api-docs",
  "plugin": ["typedoc-plugin-markdown"],

  // Load-bearing, and NOT the default. Without it the @internal tags in src/
  // are parsed and then ignored: the reference lists all 92 exported symbols,
  // including engine, CLI, and pipeline plumbing. With it, 61 remain.
  "excludeInternal": true,

  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "sort": ["kind", "alphabetical"]
}
