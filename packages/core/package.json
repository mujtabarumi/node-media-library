{
  "name": "@node-media-library/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Node port of spatie/laravel-medialibrary: attach, convert, and serve file collections for your models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujtabarumi/node-media-library.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mujtabarumi/node-media-library/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/mujtabarumi/node-media-library/issues"
  },
  "keywords": [
    "media-library",
    "uploads",
    "conversions",
    "downloads",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "bin": {
    "node-media-library": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "docs:api": "typedoc && node scripts/starlight-frontmatter.mjs",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/ensure-pnpm-pack.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "file-type": "^22.0.1",
    "flydrive": "^1.3.0",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.10.2"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.10.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yauzl": "^3.1.3"
  }
}
