{
  "name": "@node-media-library/prisma",
  "version": "0.0.0",
  "type": "module",
  "description": "Prisma adapter (MediaRepository + cascading deletes) for @node-media-library/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujtabarumi/node-media-library.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://github.com/mujtabarumi/node-media-library/tree/main/packages/prisma#readme",
  "bugs": {
    "url": "https://github.com/mujtabarumi/node-media-library/issues"
  },
  "keywords": [
    "media-library",
    "uploads",
    "conversions",
    "prisma"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/ensure-pnpm-pack.mjs",
    "db:prepare": "prisma db push && prisma generate"
  },
  "dependencies": {
    "@node-media-library/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.2 <8"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^22.20.1",
    "prisma": "^7.9.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
